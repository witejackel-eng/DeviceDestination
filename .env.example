# ─── Core ──────────────────────────────────────────────────────────────────
# Canonical production URL. Must be a real domain in production — Vercel
# preview URLs and localhost are rejected by the production check.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PRICE_MAX_AGE_DAYS=30

# ─── Database ───────────────────────────────────────────────────────────────
# Neon HTTP connection string (postgres:// or postgresql://).
DATABASE_URL=

# ─── Authentication ────────────────────────────────────────────────────────
# Required for session signing. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional override; defaults to NEXT_PUBLIC_SITE_URL.
BETTER_AUTH_URL=

# Comma-separated list of admin email addresses.
ADMIN_EMAILS=

# ─── Payments (Razorpay) ───────────────────────────────────────────────────
# The public key is embedded in the checkout form.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# The secret key is used server-side to create orders and verify payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The webhook secret is configured in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ─── Cron / job runner ─────────────────────────────────────────────────────
# A random secret that authorises the /api/internal/jobs/run endpoint.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ─── Order access tokens (Phase 8) ─────────────────────────────────────────
# Optional. If set, used to sign order-access tokens. If unset, a derived
# key is used. Must NOT be the same as BETTER_AUTH_SECRET or RAZORPAY_KEY_SECRET.
ORDER_ACCESS_SECRET=

# ─── Business / invoice identity ───────────────────────────────────────────
BUSINESS_LEGAL_NAME=
BUSINESS_GSTIN=

# ─── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
SALES_EMAIL=

# ─── WhatsApp ──────────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_ORDER_TEMPLATE_NAME=
SALES_WHATSAPP_NUMBER=
WHATSAPP_GRAPH_VERSION=

# ─── Rate limiting (Upstash) ───────────────────────────────────────────────
# Required in production for distributed rate limiting. If unset, falls back
# to in-memory rate limiting (per-instance, not safe for multi-instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Storage (Vercel Blob) ─────────────────────────────────────────────────
# Required for immutable invoice PDF storage. If unset, invoice generation
# is deferred.
BLOB_READ_WRITE_TOKEN=

# ─── Logging ───────────────────────────────────────────────────────────────
# Controls log verbosity: trace, debug, info, warn, error, fatal.
LOG_LEVEL=

# ─── Test / CI ─────────────────────────────────────────────────────────────
# Used by the integration test suite to connect to a real Postgres instance.
# Set in CI, never in production.
TEST_DATABASE_URL=
# Forces the DB driver to use node-postgres (for local/CI) instead of neon-http.
DB_DRIVER=
