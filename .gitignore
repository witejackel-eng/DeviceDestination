# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# confidential supplier and pricing research
private-data/
supplier-data/
pricing-research-private/
*.private.csv
*.cost.csv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# browser test output
playwright-report/
test-results/

# local scratch
.tmp/

# generated review screenshots (regenerate: npm run build && node scripts/capture-screenshots.mjs)
docs/screenshots/review/

# generated catalogue parity reports (regenerate: npm run products:parity)
reports/
